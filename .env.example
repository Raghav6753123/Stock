# Database (required)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=stonks

# Session authentication (required: generate two distinct long random values)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Market and AI providers (required for live data and chat)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
NEWS_API_KEY=

# Optional shared cache for production/high traffic (Upstash Redis or Vercel KV REST credentials)
# Without these, the app uses its existing per-instance in-memory caches.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SHARED_CACHE_TIMEOUT_MS=800
MARKET_QUOTE_CACHE_TTL_MS=15000
MARKET_SPARK_CACHE_TTL_MS=60000

# Hosted Python service (use the Railway public URL in Vercel)
ML_SERVICE_URL=http://127.0.0.1:8001
PY_AI_SERVICE_URL=http://127.0.0.1:8001
PY_AI_SERVICE_TIMEOUT_MS=30000

# Production-safe flags for Vercel's serverless runtime
NEWS_FINBERT_ENABLED=0
NEWS_FINBERT_ON_VERCEL=0

# Set to 1 only for the first deployment, then remove after tables are created.
AUTO_MIGRATE_DB=0
AUTO_MIGRATE_AUTH=0

# Optional Firebase client/admin configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Optional AI alternatives
CHAT_MODEL_PROVIDER=gemini
CHAT_MODEL_ENABLE_FALLBACK=true
HF_STOCK_MODEL_ENABLED=false
HF_STOCK_MODEL_URL=
HF_STOCK_MODEL_API_NAME=answer
HF_TOKEN=

# Semantic vector retrieval (BGE-small-en-v1.5 384-D vectors -> Chroma HNSW)
# Set HF_TOKEN to a Hugging Face access token with inference permission.
BGE_MODEL=BAAI/bge-small-en-v1.5
BGE_EMBEDDING_URL=
BGE_EMBEDDING_TIMEOUT_MS=8000
# Leave blank to use the standard BGE query instruction.
BGE_QUERY_PREFIX=

# Optional hosted Chroma memory. Without this, Vercel memory is ephemeral.
CHROMA_URL=
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
