# Railway database configuration
#
# Deployed on Railway: do not paste credentials here. Use Railway's Add Reference
# Variable feature to map MYSQLHOST/MYSQLPORT/MYSQLUSER/MYSQLPASSWORD/MYSQLDATABASE.
#
# Local development with the Railway database: paste the regenerated MYSQL_PUBLIC_URL
# from the Railway MySQL service. Keep this file and .env private.
MYSQL_PUBLIC_URL=

# Alternative: enter the connection values separately instead of MYSQL_PUBLIC_URL.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=railway

# Required: generate two different long random strings before deployment.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Enable only for the first deployment so the MySQL tables are created automatically.
AUTO_MIGRATE_DB=1
AUTO_MIGRATE_AUTH=1

# Optional provider keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
NEWS_API_KEY=

# Local-only alert test mode. Use symbol TEST to simulate a fixed market price.
ALERT_TEST_MODE=false
ALERT_TEST_PRICE=105

# SendGrid email approval for AI buy/sell orders
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
APP_URL=http://localhost:3000
OBSERVATION_MONITOR_SECRET=

# Chat configuration
CHAT_MODEL_PROVIDER=gemini
CHAT_MODEL_ENABLE_FALLBACK=true
HF_TOKEN=
BGE_MODEL=BAAI/bge-small-en-v1.5
BGE_EMBEDDING_URL=
BGE_EMBEDDING_TIMEOUT_MS=8000
BGE_QUERY_PREFIX=

# Optional cache and semantic-memory services
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CHROMA_URL=
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
